        { "path": "src/commands/check.ts", "line": 5, "state": "match" }
      ],
      "links": [
        { "kind": "doc", "label": "CONTEXT.md", "href": "../../CONTEXT.md" },
        { "kind": "commit", "label": "9eb7deb bootstrap", "href": "https://github.com/Decayo/ADDONE/commit/9eb7deb" }
      ]
    },

    "render": {
      "phase": "open",
      "anchors": [
        { "path": "src/render/home.ts", "line": 17, "state": "drift" }
      ],
      "links": [
        { "kind": "doc", "label": "decisions/first-slice.md#home", "href": "../../docs/decisions/first-slice.md" },
        { "kind": "issue", "label": "#7 is home one page?", "href": "https://github.com/Decayo/ADDONE/issues/7" }
