    "state": {
      "phase": "open",
      "anchors": [
        { "path": ".addone/state.json", "line": 1, "state": "match" },
        { "path": "src/state/apply.ts", "line": 31, "state": "drift" }
      ],
      "links": [
        { "kind": "doc", "label": "CONTEXT.md#state", "href": "../../CONTEXT.md" },
        { "kind": "issue", "label": "#6 who writes state?", "href": "https://github.com/Decayo/ADDONE/issues/6" }
      ]
    },

    "scope": {
      "phase": "todo",
      "anchors": [
        { "path": "src/scope/check.ts", "line": 11, "state": "match" }
      ],
      "links": [
        { "kind": "doc", "label": "agents/domain.md", "href": "../../docs/agents/domain.md" }
      ]
    },

    "watch": {
      "phase": "todo",
      "anchors": [
        { "path": "src/watch/index.ts", "line": 9, "state": "match" }
      ],
