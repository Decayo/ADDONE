{
  "_comment": "ADDONE second layer for the home map. Node ids match out/base.html. Phase precedence when a node is in several sets: open > changed > todo.",

  "openTemplate": "vscode://file/{abs}:{line}",
  "openTemplateAlternatives": [
    "https://host/open?p={path}&l={line}",
    "https://github.com/Decayo/ADDONE/blob/main/{path}#L{line}"
  ],
  "repoRoot": "/mnt/shares/arch-linux/workspace/ADDONE",

  "nodes": {
    "human": { "phase": "none" },

    "hosts": { "phase": "none" },

    "skill": {
      "phase": "changed",
      "anchors": [
        { "path": "skill/SKILL.md", "line": 1, "state": "match" },
        { "path": "skill/procedures/reconcile.md", "line": 12, "state": "drift" }
      ],
      "links": [
        { "kind": "doc", "label": "agents/issue-tracker.md", "href": "../../docs/agents/issue-tracker.md" },
        { "kind": "commit", "label": "9eb7deb bootstrap", "href": "https://github.com/Decayo/ADDONE/commit/9eb7deb" }
      ]
    },

    "hooks": {
      "phase": "changed",
      "anchors": [
        { "path": "hooks/claude.json", "line": 3, "state": "match" },
        { "path": "hooks/codex.json", "line": 3, "state": "match" }
      ],
      "links": [
        { "kind": "doc", "label": "decisions/first-slice.md", "href": "../../docs/decisions/first-slice.md" },
        { "kind": "pr", "label": "PR #12 enforcement path", "href": "https://github.com/Decayo/ADDONE/pull/12" }
